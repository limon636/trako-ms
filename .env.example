# App
NODE_ENV=development
PORT=3000

# Database
DB_HOST=localhost
DB_PORT=3306
DB_USERNAME=root
DB_PASSWORD=secret
DB_DATABASE=trako_db

# JWT - Owner (account holder)
JWT_OWNER_SECRET=change_me_owner_secret_min_32chars
JWT_OWNER_EXPIRES_IN=15m
JWT_OWNER_REFRESH_SECRET=change_me_owner_refresh_secret_min_32chars
JWT_OWNER_REFRESH_EXPIRES_IN=7d

# JWT - User (store staff)
JWT_USER_SECRET=change_me_user_secret_min_32chars
JWT_USER_EXPIRES_IN=15m
JWT_USER_REFRESH_SECRET=change_me_user_refresh_secret_min_32chars
JWT_USER_REFRESH_EXPIRES_IN=7d

# Bcrypt
BCRYPT_SALT_ROUNDS=12
